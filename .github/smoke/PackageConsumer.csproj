<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net462;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateResourceUsePreserializedResources Condition="'$(TargetFramework)' == 'net462'">false</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ObjectListView.WinForms" Version="$(ObjectListViewPackageVersion)" />
    <Compile Update="DesignerSmokeForm.cs" SubType="Form" />
    <Compile Update="DesignerSmokeForm.Designer.cs" DependentUpon="DesignerSmokeForm.cs" />
  </ItemGroup>
  <Import Project="VerifyDesignerReference.targets" />
</Project>
