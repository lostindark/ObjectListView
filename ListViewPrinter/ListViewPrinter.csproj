<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BrightIdeasSoftware</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Preserve the wildcard assembly version in Properties\AssemblyInfo.cs. -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Design" Condition="'$(TargetFramework)' == 'net462'" />
    <ProjectReference Include="..\ObjectListView\ObjectListView.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="BrushForm.cs" SubType="Form" />
    <Compile Update="BrushForm.Designer.cs" DependentUpon="BrushForm.cs" />
    <Compile Update="ListViewPrinter.cs" SubType="Component" />
    <EmbeddedResource Update="BrushForm.resx" DependentUpon="BrushForm.cs" SubType="Designer" />
  </ItemGroup>
</Project>
