<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BrightIdeasSoftware</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Preserve the wildcard assembly version in Properties\AssemblyInfo.cs. -->
    <Deterministic>false</Deterministic>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>olv-keyfile.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateResourceUsePreserializedResources Condition="'$(TargetFramework)' == 'net462'">false</GenerateResourceUsePreserializedResources>
    <PackageId>ObjectListView.WinForms</PackageId>
    <Version>3.0.0-dev</Version>
    <Title>ObjectListView for Windows Forms</Title>
    <Authors>Phillip Piper; Teddy Z</Authors>
    <Description>A maintained fork of ObjectListView, a Windows Forms ListView control with model-based rows, sorting, grouping, filtering, cell editing, and tree views.</Description>
    <PackageProjectUrl>https://github.com/lostindark/ObjectListView</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lostindark/ObjectListView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>WinForms;ListView;ObjectListView;Controls</PackageTags>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeModernDesigners</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="Accessibility" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Design" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="DataTreeListView.cs" SubType="Component" />
    <Compile Update="Implementation\Enums.cs" SubType="Component" />
    <Compile Update="OLVColumn.cs" SubType="Component" />
    <Compile Update="DataListView.cs" SubType="Component" />
    <Compile Update="Implementation\Events.cs" SubType="Component" />
    <Compile Update="FastDataListView.cs" SubType="Component" />
    <Compile Update="FastObjectListView.cs" SubType="Component" />
    <Compile Update="Rendering\TreeRenderer.cs" SubType="Component" />
    <Compile Update="SubControls\ToolStripCheckedListBox.cs" SubType="Component" />
    <Compile Update="Utilities\ColumnSelectionForm.cs" SubType="Form" />
    <Compile Update="Utilities\ColumnSelectionForm.Designer.cs" DependentUpon="ColumnSelectionForm.cs" />
    <Compile Update="SubControls\GlassPanelForm.cs" SubType="Form" />
    <Compile Update="SubControls\HeaderControl.cs" SubType="Code" />
    <Compile Update="ObjectListView.cs" SubType="Component" />
    <Compile Update="ObjectListViewBase.cs" SubType="Component" />
    <Compile Update="Rendering\Renderers.cs" SubType="Component" />
    <Compile Update="Rendering\Styles.cs" SubType="Component" />
    <Compile Update="TreeListView.cs" SubType="Component" />
    <Compile Update="VirtualObjectListView.cs" SubType="Component" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="true" DesignTime="true" DependentUpon="Resources.resx" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" SubType="Designer" />
    <EmbeddedResource Update="Utilities\ColumnSelectionForm.resx" DependentUpon="ColumnSelectionForm.cs" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Target Name="IncludeModernDesigners" Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ItemGroup>
      <_DesignerFile Include="..\ObjectListView.Design.Client\bin\$(Configuration)\net472\ObjectListView.Design.Client.dll" TargetPath="Design\WinForms\ObjectListView.Design.Client.dll" />
      <_DesignerFile Include="..\ObjectListView.Design.Protocol\bin\$(Configuration)\net472\ObjectListView.Design.Protocol.dll" TargetPath="Design\WinForms\ObjectListView.Design.Protocol.dll" />
      <_DesignerFile Include="..\ListViewPrinter\bin\$(Configuration)\net462\ListViewPrinter.dll" TargetPath="Design\WinForms\ListViewPrinter.dll" />
      <_DesignerFile Include="bin\$(Configuration)\net462\ObjectListView.dll" TargetPath="Design\WinForms\ObjectListView.dll" />
      <_DesignerFile Include="..\ObjectListView.Design.Server\bin\$(Configuration)\net10.0-windows\ObjectListView.Design.Server.dll" TargetPath="Design\WinForms\Server\ObjectListView.Design.Server.dll" />
      <_DesignerFile Include="..\ObjectListView.Design.Protocol\bin\$(Configuration)\net10.0-windows\ObjectListView.Design.Protocol.dll" TargetPath="Design\WinForms\Server\ObjectListView.Design.Protocol.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(_DesignerFile.Identity)')" Text="Missing designer asset %(_DesignerFile.Identity). Build ObjectListView.sln before packing." />
    <ItemGroup>
      <BuildOutputInPackage Include="@(_DesignerFile)" />
    </ItemGroup>
  </Target>
</Project>
