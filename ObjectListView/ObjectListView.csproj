<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BrightIdeasSoftware</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <GenerateAssemblyTrademarkAttribute>false</GenerateAssemblyTrademarkAttribute>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <Deterministic>true</Deterministic>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>olv-keyfile.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateResourceUsePreserializedResources Condition="'$(TargetFramework)' == 'net462'">false</GenerateResourceUsePreserializedResources>
    <PackageId>ObjectListView.WinForms</PackageId>
    <Version>3.0.0-preview</Version>
    <Title>ObjectListView for Windows Forms</Title>
    <Authors>Phillip Piper; Teddy Z</Authors>
    <Description>A maintained fork of ObjectListView, a Windows Forms ListView control with model-based rows, sorting, grouping, filtering, cell editing, and tree views.</Description>
    <PackageProjectUrl>https://github.com/lostindark/ObjectListView</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lostindark/ObjectListView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>WinForms;ListView;ObjectListView;Controls</PackageTags>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeFrameworkDesigner;IncludeModernDesigners</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="Accessibility" />
    <Reference Include="System.Configuration" />
  </ItemGroup>
  <Target Name="IncludeFrameworkDesigner" Condition="'$(TargetFramework)' == 'net462'">
    <ItemGroup>
      <_FrameworkDesignerFile Include="..\ObjectListView.Design.Framework\bin\$(Configuration)\net462\ObjectListView.Design.Framework.dll"
                              TargetPath="Design\WinForms\ObjectListView.Design.Framework.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(_FrameworkDesignerFile.Identity)')" Text="Missing designer asset %(_FrameworkDesignerFile.Identity). Build ObjectListView.sln before packing." />
    <ItemGroup>
      <BuildOutputInPackage Include="@(_FrameworkDesignerFile)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Update="TypedDataTreeListView.cs" SubType="Component" />
    <Compile Update="OLVColumn.cs" SubType="Component" />
    <Compile Update="TypedDataListView.cs" SubType="Component" />
    <Compile Update="TypedFastDataListView.cs" SubType="Component" />
    <Compile Update="TypedFastObjectListView.cs" SubType="Component" />
    <Compile Update="TypedTreeListView.Renderer.cs" SubType="Component" />
    <Compile Update="SubControls\ToolStripCheckedListBox.cs" SubType="Component" />
    <Compile Update="SubControls\ColumnSelectionForm.cs" SubType="Form" />
    <Compile Update="SubControls\ColumnSelectionForm.Designer.cs" DependentUpon="ColumnSelectionForm.cs" />
    <Compile Update="SubControls\GlassPanelForm.cs" SubType="Form" />
    <Compile Update="SubControls\HeaderControl.cs" SubType="Code" />
    <Compile Update="ObjectListViewBase.cs" SubType="Component" />
    <Compile Update="Rendering\Renderers.cs" SubType="Component" />
    <Compile Update="Rendering\Styles.cs" SubType="Component" />
    <Compile Update="TypedTreeListView.cs" SubType="Component" />
    <Compile Update="TypedVirtualObjectListView.cs" SubType="Component" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="true" DesignTime="true" DependentUpon="Resources.resx" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" SubType="Designer" />
    <EmbeddedResource Update="SubControls\ColumnSelectionForm.resx" DependentUpon="ColumnSelectionForm.cs" LogicalName="BrightIdeasSoftware.ColumnSelectionForm.resources" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="build\ObjectListView.WinForms.targets" Pack="true" PackagePath="build\;buildTransitive\" />
  </ItemGroup>
  <Target Name="IncludeModernDesigners" Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ItemGroup>
      <_DesignerFile Include="..\ObjectListView.Design.Client\bin\$(Configuration)\net472\ObjectListView.Design.Client.dll" TargetPath="Design\WinForms\ObjectListView.Design.Client.dll" />
      <_DesignerFile Include="..\ObjectListView.Design.Protocol\bin\$(Configuration)\net472\ObjectListView.Design.Protocol.dll" TargetPath="Design\WinForms\ObjectListView.Design.Protocol.dll" />
      <_DesignerFile Include="..\ObjectListView.Design.Server\bin\$(Configuration)\net10.0-windows\ObjectListView.Design.Server.dll" TargetPath="Design\WinForms\Server\ObjectListView.Design.Server.dll" />
      <_DesignerFile Include="..\ObjectListView.Design.Protocol\bin\$(Configuration)\net10.0-windows\ObjectListView.Design.Protocol.dll" TargetPath="Design\WinForms\Server\ObjectListView.Design.Protocol.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(_DesignerFile.Identity)')" Text="Missing designer asset %(_DesignerFile.Identity). Build ObjectListView.sln before packing." />
    <ItemGroup>
      <BuildOutputInPackage Include="@(_DesignerFile)" />
    </ItemGroup>
  </Target>
</Project>
