<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tests</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Design" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Program.cs" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <ProjectReference Include="..\ObjectListView\ObjectListView.csproj" />
    <ProjectReference Include="..\ListViewPrinter\ListViewPrinter.csproj" />
    <Compile Include="..\ObjectListView.Design.Protocol\PrinterEditorState.cs" Link="PrinterEditorState.cs" />
    <Compile Include="..\ObjectListView.Design.Server\ColumnResizeTransaction.cs" Link="ColumnResizeTransaction.cs" />
  </ItemGroup>
</Project>
